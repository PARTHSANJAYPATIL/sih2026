# Django Secret & Debug
SECRET_KEY=django-insecure-f2m-ai-super-secret-key-for-development-sih-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL with automatic SQLite fallback)
# To use PostgreSQL:
# POSTGRES_DB=farm2market
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Or:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm2market

# CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Settings
ACCESS_TOKEN_LIFETIME_MINUTES=120
REFRESH_TOKEN_LIFETIME_DAYS=7
